# -----------------------------------------------------------------------------
# Mezo — environment variables
#
# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local, real keys, or service-role credentials.
# -----------------------------------------------------------------------------

# Public Supabase project configuration (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase key. Never prefix this with NEXT_PUBLIC_.
# Bypasses Row Level Security: use only in server-only modules.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical application URL (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — only for local/remote staging testing with npm run test:db:staging.
# Never set these in production, never commit real values to the repository.
# MEZO_STAGING_PROJECT_REF=your-staging-ref
# SUPABASE_DB_PASSWORD=your-staging-database-password
# Optional pooler host override if your region route differs.
# MEZO_STAGING_DB_HOST=aws-1-eu-central-1.pooler.supabase.com
